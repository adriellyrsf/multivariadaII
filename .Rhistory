eig_tab <- as.data.frame(get_eigenvalue(acp))
eig_tab <- round(eig_tab, 3)
eig_tab$Componente <- paste0("CP", 1:nrow(eig_tab))
eig_tab <- eig_tab[, c("Componente", "eigenvalue", "variance.percent", "cumulative.variance.percent")]
names(eig_tab) <- c("Componente", "Autovalor", "% Variância", "% Variância acumulada")
knitr::kable(eig_tab, caption = "Tabela 4: Autovalores e variância explicada por componente.", row.names = FALSE)
fviz_pca_var(acp, axes = c(1,2), col.var = "contrib",
gradient.cols = c("#f2c4c4", "#c1272d", "#8B0000"),
repel = TRUE, title = "Círculo de correlações - CP1 x CP2")
acp <- PCA(dados2, scale.unit = TRUE, graph = FALSE)
fviz_eig(acp, addlabels = TRUE, barfill = "#8B0000", barcolor = "#8B0000",
main = "Percentual de variância explicada por componente")
comu <- data.frame(
Variável = rownames(acp$var$cos2),
`Comunalidade (3 CPs)` = round(rowSums(acp$var$cos2[,1:3]), 3),
check.names = FALSE
)
comu <- comu[order(-comu$`Comunalidade (3 CPs)`), ]
knitr::kable(comu, caption = "Tabela 6: Comunalidade de cada variável considerando os três primeiros componentes.", row.names = FALSE)
dados_cluster <- acp$ind$coord[, 1:2]
distancias <- dist(dados_cluster)
# escolhendo o número de grupos.
grupos <- cutree(hc, k = 4)
De modo geral, os resultados mostram que a realidade dos municípios nordestinos é bastante heterogênea. Assim, a utilização conjunta da Análise de Componentes Principais e da análise de cluster mostrou-se uma estratégia adequada para sintetizar os dados e identificar perfis semelhantes entre os municípios, podendo contribuir para o planejamento de políticas públicas mais direcionadas às necessidades de cada grupo.
