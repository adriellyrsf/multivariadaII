#Importando o banco de dados
dados = read_csv("dados_final_nordeste.csv")
summary(dados)
# Selecionando apenas as variáveis utilizadas da análise
dados_acp <- dados %>%
select(
-id_municipio,
-nome,
-sigla_uf
)
summary(dados_acp)
corrplot(
cor(dados_acp),
method = "color",
type = "upper",
tl.col = "black"
)
par(mfrow = c(4, 3), mar = c(4, 4, 2, 1))
for (v in names(dados_acp)) {
hist(dados_acp[[v]], main = v, xlab = "", col = "#8B0000", border = "white")
}
par(mfrow = c(4, 3), mar = c(4, 4, 2, 1))
for (v in names(dados_acp)) {
boxplot(dados_acp[[v]], main = v, col = "#f2c4c4", horizontal = TRUE)
}
outliers_tab <- data.frame(
Variável = names(dados_acp),
`Nº de outliers` = sapply(dados_acp, function(x) {
q1 <- quantile(x, .25); q3 <- quantile(x, .75); iqr <- q3 - q1
sum(x < q1 - 1.5*iqr | x > q3 + 1.5*iqr)
}),
`% da amostra` = sapply(dados_acp, function(x) {
q1 <- quantile(x, .25); q3 <- quantile(x, .75); iqr <- q3 - q1
round(100*mean(x < q1 - 1.5*iqr | x > q3 + 1.5*iqr), 1)
}),
check.names = FALSE
)
knitr::kable(outliers_tab, caption = "Tabela 2: Outliers univariados por variável (critério do boxplot).", row.names = FALSE)
center <- colMeans(dados_acp)
covm <- cov(dados_acp)
mdist <- mahalanobis(dados_acp, center, covm)
cutoff <- qchisq(0.995, df = ncol(dados_acp))
n_mv_out <- sum(mdist > cutoff)
idx <- order(mdist, decreasing = TRUE)[1:10]
tab_mv <- data.frame(
Município = dados$nome[idx],
UF = dados$sigla_uf[idx],
`Distância de Mahalanobis` = round(mdist[idx], 1),
check.names = FALSE
)
knitr::kable(tab_mv, caption = paste0("Tabela 3: 10 municípios com maior distância de Mahalanobis (de um total de ",
n_mv_out, " outliers multivariados, ",
round(100*n_mv_out/nrow(dados),1), "% da amostra, considerando o percentil 99,5% da distribuição qui-quadrado)."),
row.names = FALSE)
kmo_res <- KMO(dados_acp)
bart_res <- cortest.bartlett(cor(dados_acp), n = nrow(dados_acp))
cat("KMO global (Measure of Sampling Adequacy):", round(kmo_res$MSA, 3), "\n")
cat("Teste de Bartlett: qui-quadrado =", round(bart_res$chisq, 2),
"| df =", bart_res$df, "| p-valor =", format.pval(bart_res$p.value, digits = 3), "\n")
